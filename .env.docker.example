
# Docker PostgreSQL credentials
POSTGRES_DB=ai_traffic_intelligence
POSTGRES_USER=ai_traffic_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_ALPHANUMERIC_PASSWORD

# Required Google Routes API key
GOOGLE_MAPS_API_KEY=REPLACE_WITH_YOUR_GOOGLE_MAPS_API_KEY

# Application
APP_NAME=AI Traffic Intelligence API
APP_ENV=production
APP_VERSION=0.1.0

# Weather configuration
WEATHER_LATITUDE=17.4065
WEATHER_LONGITUDE=78.4772
WEATHER_LOCATION_NAME=Hyderabad

# Traffic route configuration
TRAFFIC_ROUTE_ID=hyderabad_route_1
TRAFFIC_ORIGIN_LATITUDE=17.4065
TRAFFIC_ORIGIN_LONGITUDE=78.4772
TRAFFIC_DESTINATION_LATITUDE=17.4486
TRAFFIC_DESTINATION_LONGITUDE=78.3908
TRAFFIC_ROUTING_PREFERENCE=TRAFFIC_AWARE

# Background ingestion intervals
INGESTION_TRAFFIC_INTERVAL_SECONDS=300
INGESTION_WEATHER_INTERVAL_SECONDS=900
